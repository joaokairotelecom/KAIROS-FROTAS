{
  "root": true,
  "env": { "browser": true, "es2022": true },
  "parserOptions": { "ecmaVersion": "latest", "sourceType": "module", "ecmaFeatures": { "jsx": true } },
  "extends": ["eslint:recommended"],
  "globals": { "React": "readonly" },
  "rules": {
    "no-unused-vars": "warn",
    "no-empty": "off"
  }
}

# ==== Kairos Frota ERP — variáveis de ambiente ====
# Copie este arquivo para .env e preencha com as chaves do SEU projeto Supabase.
# NUNCA versione o arquivo .env (ele está no .gitignore).

# URL do projeto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública anon (Project Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJI...SUA_CHAVE_ANON

# (Opcional) Modelo de IA usado nas análises
VITE_AI_MODEL=claude-sonnet-4-6
